# API server
API_PORT=4000

# Comma-separated origins allowed to send cookies (storefront + admin apps).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Sign/verify session cookies. Generate a real random value for production,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
AUTH_JWT_SECRET=dev-only-secret-change-in-production

# Used to build punchout StartPage URLs back to the storefront.
STOREFRONT_URL=http://localhost:3000

# Dev database: embedded Postgres (PGlite, WASM) — no server needed.
# This is a folder where PGlite persists data.
PGLITE_DATA=./pgdata

# Production database: set DATABASE_URL to a real Postgres and it takes over
# automatically (e.g. the Postgres from docker-compose.yml on your droplet).
# DATABASE_URL=postgresql://signet:signet@localhost:5432/signet

# ERP provider: mock | acumatica  (mock runs with zero credentials)
ERP_PROVIDER=mock

# Acumatica (only needed when ERP_PROVIDER=acumatica)
ACUMATICA_BASE_URL=
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=
ACUMATICA_TENANT=
ACUMATICA_BRANCH=
